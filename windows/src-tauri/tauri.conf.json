{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siftly",
  "version": "0.2.0",
  "identifier": "com.yinxu.siftly.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Siftly",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "backgroundColor": "#121416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Thoughtful photo culling, right on your card.",
    "category": "Photography",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    },
    "resources": [
      "../THIRD_PARTY_NOTICES.md",
      "../licenses/*"
    ]
  }
}
